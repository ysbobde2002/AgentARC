PORT=5180
ARC_NETWORK=testnet

# Circle Agent Wallets (developer-controlled on Arc Testnet)
# 1. CIRCLE_API_KEY — Console → https://console.circle.com → API Keys (Wallets)
# 2. CIRCLE_ENTITY_SECRET — generate + register once:
#    https://developers.circle.com/wallets/dev-controlled/register-entity-secret
#    Circle stores the ciphertext; you keep the 32-byte hex. This is NOT an EOA private key.
# 3. Then run: npm run setup:wallets
#    It prints CIRCLE_WALLET_SET_ID, BUYER/SELLER/OPERATOR _WALLET_ID and _ADDRESS.
# 4. Fund those addresses with Arc Testnet USDC: https://faucet.circle.com
#
# You do not need MetaMask, card numbers, or wallet private keys.
# The agent spends USDC from the Buyer Agent Wallet inside spend policy.

CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
BUYER_WALLET_ID=
SELLER_WALLET_ID=
OPERATOR_WALLET_ID=
BUYER_WALLET_ADDRESS=
SELLER_WALLET_ADDRESS=
OPERATOR_WALLET_ADDRESS=

# Arc Testnet (mainnet: set ARC_NETWORK=mainnet + ARC_MAINNET_* overrides)
ARC_RPC_URL=https://rpc.testnet.arc.network
USDC_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000
ARC_EXPLORER_URL=https://testnet.arcscan.app
GATEWAY_API_URL=https://gateway-api-testnet.circle.com

# Optional onchain AgentJobEscrow. Leave empty to escrow via the operator wallet.
AUTH_CAPTURE_ESCROW_ADDRESS=
ERC3009_COLLECTOR_ADDRESS=

# ERC-8004 identities (public Sepolia records — no private keys)
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
ERC8004_CHAIN_ID=11155111
BUYER_AGENT_ID=9638
SELLER_AGENT_ID=6832
BUYER_AGENT_NAME=Buyer Agent
SELLER_AGENT_NAME=Market Data Agent
SCAN8004_API_BASE=https://8004scan.io/api/v1/public
SCAN8004_WEB_BASE=https://testnet.8004scan.io

# Dedicated Arc x402 seller (started by npm run demo)
SELLER_PORT=5181
SELLER_ORIGIN=http://127.0.0.1:5181

# Policy thresholds (USD)
NANO_MAX_USD=1
PROTECT_MIN_USD=100

MARKET_DATA_SOURCE=coingecko

# Optional — OpenAI intent matching (regex fallback if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
